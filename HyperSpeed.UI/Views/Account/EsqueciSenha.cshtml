@using hyperSpeed.Application.ViewModels
@model EsqueciSenhaViewModel

@{
    ViewData["Title"] = "Esqueci minha senha";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Esqueci minha senha - HyperSpeed</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="img/Icone HS.png">

</head>

<body>

    <div class="login-page">

        <div class="login-brand">

            <div class="login-brand-content">

                <div class="login-logo">
                    <span>HYPER</span>
                    <strong>SPEED</strong>
                </div>

                <div class="login-brand-line"></div>

                <h1>
                    ESQUECEU SUA SENHA?<br />
                    <strong>SEM PROBLEMA.</strong>
                </h1>

                <p>
                    Informe o e-mail da sua conta e vamos te ajudar
                    a criar uma nova senha.
                </p>

            </div>

        </div>


        <div class="login-area">

            <div class="login-card">

                <div class="login-header">

                    <span class="login-label">
                        HYPERSPEED / RECUPERAÇÃO
                    </span>

                    <h2>Esqueci minha senha</h2>

                    <p>
                        Digite o e-mail cadastrado na sua conta.
                    </p>

                </div>


                <form asp-controller="Conta"
                      asp-action="EsqueciSenha"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="login-validation"></div>


                    <div class="login-field">

                        <label asp-for="Email">Email</label>

                        <div class="login-input">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="Email"
                                   type="email"
                                   placeholder="Digite seu email"
                                   autocomplete="email"
                                   autofocus
                                   required />

                        </div>

                        <span asp-validation-for="Email" class="login-error"></span>

                    </div>


                    <button type="submit" class="login-button">
                        <span>Enviar recuperação</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>

                </form>


                <div class="login-register">
                    <a asp-controller="Conta" asp-action="RedefinirSenha" class="login-secondary-link">
                        Já tenho um token, redefinir senha
                    </a>
                </div>


                <div class="login-back">
                    <a asp-controller="Conta" asp-action="Login">
                        <i class="bi bi-arrow-left"></i>
                        Voltar para o login
                    </a>
                </div>


                <div class="login-footer">
                    <i class="bi bi-shield-check"></i>
                    Ambiente seguro e protegido
                </div>

            </div>

        </div>

    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>

</html>
