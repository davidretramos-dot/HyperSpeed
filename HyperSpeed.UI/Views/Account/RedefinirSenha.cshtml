@using hyperSpeed.Application.ViewModels
@model RedefinirSenhaViewModel

@{
    ViewData["Title"] = "Redefinir senha";
    Layout = null;
    var tokenGerado = TempData["TokenGerado"] as string;
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Redefinir senha - HyperSpeed</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="img/Icone HS.png">

</head>

<body>

    <div class="login-page">

        <div class="login-brand">

            <div class="login-brand-content">

                <div class="login-logo">
                    <span>HYPER</span>
                    <strong>SPEED</strong>
                </div>

                <div class="login-brand-line"></div>

                <h1>
                    QUASE LÁ.<br />
                    <strong>CRIE UMA NOVA SENHA.</strong>
                </h1>

                <p>
                    Confira seu token de recuperação e defina
                    uma nova senha para sua conta.
                </p>

            </div>

        </div>


        <div class="login-area">

            <div class="login-card">

                <div class="login-header">

                    <span class="login-label">
                        HYPERSPEED / RECUPERAÇÃO
                    </span>

                    <h2>Redefinir senha</h2>

                    <p>
                        Preencha os campos abaixo para concluir a recuperação.
                    </p>

                </div>


                @if (!string.IsNullOrEmpty(tokenGerado) || !string.IsNullOrWhiteSpace(Model.Token))
                {
                    <div class="login-info">

                        <i class="bi bi-info-circle"></i>

                        <div>
                            <strong>Versão acadêmica do sistema</strong>
                            <p>
                                Em produção este token seria enviado por e-mail.
                                Aqui ele já foi preenchido automaticamente para você.
                            </p>
                        </div>

                    </div>
                }


                <form asp-controller="Conta"
                      asp-action="RedefinirSenha"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="login-validation"></div>


                    <div class="login-field">

                        <label asp-for="Email">Email</label>

                        <div class="login-input">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="Email"
                                   type="email"
                                   placeholder="Digite seu email"
                                   autocomplete="email"
                                   required />

                        </div>

                        <span asp-validation-for="Email" class="login-error"></span>

                    </div>


                    <div class="login-field">

                        <label asp-for="Token">Token de recuperação</label>

                        <div class="login-input">

                            <i class="bi bi-key"></i>

                            <input asp-for="Token"
                                   type="text"
                                   placeholder="Cole aqui o token recebido"
                                   autocomplete="one-time-code"
                                   required />

                        </div>

                        <span asp-validation-for="Token" class="login-error"></span>

                    </div>


                    <div class="login-field">

                        <label asp-for="NovaSenha">Nova senha</label>

                        <div class="login-input">

                            <i class="bi bi-lock"></i>

                            <input asp-for="NovaSenha"
                                   type="password"
                                   id="novaSenha"
                                   placeholder="Digite a nova senha"
                                   autocomplete="new-password"
                                   required />

                            <button type="button" class="password-toggle" onclick="togglePassword('novaSenha','iconNovaSenha')">
                                <i class="bi bi-eye" id="iconNovaSenha"></i>
                            </button>

                        </div>

                        <span asp-validation-for="NovaSenha" class="login-error"></span>

                    </div>


                    <div class="login-field">

                        <label asp-for="ConfirmarNovaSenha">Confirmar nova senha</label>

                        <div class="login-input">

                            <i class="bi bi-lock"></i>

                            <input asp-for="ConfirmarNovaSenha"
                                   type="password"
                                   id="confirmarNovaSenha"
                                   placeholder="Repita a nova senha"
                                   autocomplete="new-password"
                                   required />

                            <button type="button" class="password-toggle" onclick="togglePassword('confirmarNovaSenha','iconConfirmarSenha')">
                                <i class="bi bi-eye" id="iconConfirmarSenha"></i>
                            </button>

                        </div>

                        <span asp-validation-for="ConfirmarNovaSenha" class="login-error"></span>

                    </div>


                    <button type="submit" class="login-button">
                        <span>Redefinir senha</span>
                        <i class="bi bi-check2"></i>
                    </button>

                </form>


                <div class="login-back">
                    <a asp-controller="Conta" asp-action="Login">
                        <i class="bi bi-arrow-left"></i>
                        Voltar para o login
                    </a>
                </div>


                <div class="login-footer">
                    <i class="bi bi-shield-check"></i>
                    Ambiente seguro e protegido
                </div>

            </div>

        </div>

    </div>

    <script>
            function togglePassword(inputId, iconId) {
                const input = document.getElementById(inputId);
                const icon = document.getElementById(iconId);

                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.remove("bi-eye");
                    icon.classList.add("bi-eye-slash");
                } else {
                    input.type = "password";
                    icon.classList.remove("bi-eye-slash");
                    icon.classList.add("bi-eye");
                }
            }
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>

</html>
