@model RegistoDto

@{

    ViewData["Title"] = "Criar Conta";

}

<div class="login-page">

    <div class="login-card">

        <div class="login-header">

            <span class="login-label">

                HYPERSPEED / CONTA
            </span>

            <h1>Criar Conta</h1>

            <p>

                Crie sua conta e aproveite tudo que a HyperSpeed oferece.
            </p>

        </div>

 
        <form asp-controller="Conta"
              asp-action="Register"
              method="post"
              novalidate>

            @Html.AntiForgeryToken()

 
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

 
            <!-- EMAIL -->

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">

                    E-mail

                </label>

                <div class="input-icon">

                    <i class="bi bi-envelope"></i>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="seu@email.com"
                           required />

                </div>

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

 
            <!-- SENHA -->

            <div class="mb-3">

                <label asp-for="Senha"
                       class="form-label">

                    Senha

                </label>

                <div class="input-icon">

                    <i class="bi bi-lock"></i>

                    <input asp-for="Senha"
                           type="password"
                           class="form-control"
                           placeholder="••••••••"
                           required />

                </div>

                <span asp-validation-for="Senha"
                      class="text-danger">
                </span>

                <small class="password-info">

                    A senha deve possuir pelo menos 6 caracteres.

                </small>

            </div>

 
            <!-- CONFIRMAR SENHA -->

            <div class="mb-4">

                <label asp-for="ConfirmarSenha"
                       class="form-label">

                    Confirmar Senha

                </label>

                <div class="input-icon">

                    <i class="bi bi-lock-fill"></i>

                    <input asp-for="ConfirmarSenha"
                           type="password"
                           class="form-control"
                           placeholder="••••••••"
                           required />

                </div>

                <span asp-validation-for="ConfirmarSenha"
                      class="text-danger">
                </span>

            </div>

 
            <!-- BOTÃO -->

            <button type="submit"
                    class="btn-register">

                <i class="bi bi-person-plus"></i>

                Criar Conta

            </button>

        </form>

 
        <!-- LINKS -->

        <div class="login-links">

            <p>

                Já possui uma conta?

                <a asp-controller="Conta"
                   asp-action="Login">

                    Entrar

                </a>

            </p>

 
            <a asp-controller="Home"
               asp-action="Index"
               class="back-store">

                <i class="bi bi-arrow-left"></i>

                Voltar à loja

            </a>

        </div>

    </div>

</div>

 
@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

 