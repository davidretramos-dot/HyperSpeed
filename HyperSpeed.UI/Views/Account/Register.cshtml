
@model RegistoDto



@{
    ViewData["Title"] = "Criar Conta";
}

<div class="login-page">
    <div class="login-card">

        <h1>Criar Conta</h1>

        <form asp-controller="Conta" asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">E-mail</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="seu@email.com" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Senha</label>
                <input asp-for="Senha" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="Senha" class="text-danger"></span>
                <small class="text-muted">Mínimo 6 caracteres (conforme regras do Identity configuradas).</small>
            </div>

            <div class="mb-3">
                <label class="form-label">Confirmar Senha</label>
                <input asp-for="ConfirmarSenha" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"></button>
            </form>

        <h1>Criar Conta</h1>

        <form asp-controller="Conta" asp-action="Registro" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">

                <label asp-for="Email"></label>

                <input asp-for="Email" class="form-control" />

                <span asp-validation-for="Email" class="text-danger"></span>

            </div>

            <div class="form-group">

                <label asp-for="Email"></label>

                <input asp-for="Email" class="form-control" />

                <span asp-validation-for="Email" class="text-danger"></span>

            </div>

            <div class="form-group">

                <label asp-for="Senha"></label>

                <input asp-for="Senha" class="form-control" />

                <span asp-validation-for="Senha" class="text-danger"></span>

            </div>

            <div class="form-group">

                <label asp-for="ConfirmarSenha"></label>

                <input asp-for="ConfirmarSenha" class="form-control" />

                <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>

            </div>

            <button type="submit" class="admin-btn">

                Criar Conta

            </button>
        </form>

        <div class="login-links mt-3">
            <a asp-controller="Conta" asp-action="Login">Já possui uma conta?</a>
            <span> | </span>
            <a asp-controller="Home" asp-action="Index">Voltar à loja</a>

        <div class="login-links">

            <p>Já possui uma conta?</p>

            <a asp-controller="Conta"
               asp-action="Login">

                Entrar

            </a>


        </div>
    </div>

</div>


</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
