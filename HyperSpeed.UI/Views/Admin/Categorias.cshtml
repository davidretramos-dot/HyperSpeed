@model IEnumerable<CategoriasDTo>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gerenciar Categorias";
}

<div class="admin">
    <main class="admin-content">
        <div class="admin-header">
            <h1>Categorias</h1>
            <a asp-controller="Admin" asp-action="CreateCategoria" class="admin-btn">+ Nova Categoria</a>
        </div>

        <div class="admin-search mb-3">
            <input type="text" class="form-control" placeholder="Pesquisar categoria..." />
        </div>

        @if (Model != null && Model.Any())
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Categoria</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in Model)
                    {
                        <tr>
                            <td>@categoria.Id</td>
                            <td>@categoria.Nome</td>
                            <td>
                                <a asp-controller="Admin" asp-action="EditCategoria" asp-route-id="@categoria.Id" class="btn-editar">Editar</a>
                                <a asp-controller="Admin" asp-action="DeleteCategoria" asp-route-id="@categoria.Id" class="btn-excluir ms-2">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">Nenhuma categoria encontrada.</div>
        }
    </main>
</div>