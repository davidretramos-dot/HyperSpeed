@model CriacaoCategoriaDTo

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nova Categoria";
}

<div class="formHS-page">

    <div class="formHS">

        <div class="formHS-header">

            <span class="formHS-label">
                HYPERSPEED / CATEGORIAS
            </span>

            <h1>Nova Categoria</h1>

            <p>
                Cadastre uma nova categoria para os produtos.
            </p>

        </div>


        <form asp-controller="Admin"
              asp-action="CreateCategoria"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="mb-3">

                <label asp-for="Nome"
                       class="form-label">

                    Nome da Categoria

                </label>


                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Ex: Periféricos"
                       required />


                <span asp-validation-for="Nome"
                      class="text-danger">
                </span>

            </div>


            <hr class="my-4" />


            <div class="formHS-actions">

                <a asp-controller="Categoria"
                   asp-action="Index"
                   class="admin-btn admin-btn-outline">

                    <i class="bi bi-arrow-left"></i>
                    Cancelar

                </a>


                <button type="submit"
                        class="admin-btn">

                    <i class="bi bi-check-lg"></i>
                    Cadastrar Categoria

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}