@model CriacaoCategoriaDTo

@{
    Layout = null;
    ViewData["Title"] = "Nova Categoria";
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HyperSpeed Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <div class="admin">

        <!-- SIDEBAR -->

        <aside class="admin-sidebar">

            <div class="admin-brand">

                <div class="admin-brand-icon">
                    <i class="bi bi-speedometer2"></i>
                </div>

                <div>
                    <strong>HYPER</strong>
                    <span>SPEED</span>
                </div>

            </div>

            <div class="admin-menu-title">
                ADMINISTRAÇÃO
            </div>

            <nav class="admin-menu">

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-menu-item">

                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>

                </a>

                <a asp-controller="Admin"
                   asp-action="Produtos"
                   class="admin-menu-item">

                    <i class="bi bi-box-seam-fill"></i>
                    <span>Produtos</span>

                </a>

                <a asp-controller="Admin"
                   asp-action="Categorias"
                   class="admin-menu-item active">

                    <i class="bi bi-tags-fill"></i>
                    <span>Categorias</span>

                </a>

                <a asp-controller="Pedido"
                   asp-action="Index"
                   class="admin-menu-item">

                    <i class="bi bi-cart-fill"></i>
                    <span>Pedidos</span>

                </a>

            </nav>

            <div class="admin-sidebar-bottom">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="admin-menu-item">

                    <i class="bi bi-arrow-left-circle-fill"></i>
                    <span>Voltar ao Site</span>

                </a>

            </div>

        </aside>


        <!-- CONTEÚDO -->

        <main class="admin-content">

            <header class="admin-header">

                <div>

                    <span class="admin-header-label">
                        HYPERSPEED / CATEGORIAS
                    </span>

                    <h1>Nova Categoria</h1>

                    <p>
                        Cadastre uma nova categoria para organizar os produtos da loja.
                    </p>

                </div>

                <div class="admin-header-icon">
                    <i class="bi bi-tags-fill"></i>
                </div>

            </header>


            <!-- FORMULÁRIO -->

            <section class="admin-form-section">

                <div class="admin-form-header">

                    <div class="admin-form-title">

                        <div class="admin-form-icon">
                            <i class="bi bi-tag-fill"></i>
                        </div>

                        <div>
                            <span class="section-label">
                                CATEGORIA
                            </span>

                            <h2>Informações da categoria</h2>
                        </div>

                    </div>

                </div>


                <form asp-action="CreateCategoria"
                      method="post"
                      novalidate>

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="admin-validation mb-3">
                    </div>


                    <div class="admin-form-group">

                        <label asp-for="Nome">
                            Nome da Categoria
                        </label>

                        <div class="admin-input-wrapper">

                            <i class="bi bi-tag"></i>

                            <input asp-for="Nome"
                                   class="admin-input"
                                   placeholder="Ex: Periféricos"
                                   required />

                        </div>

                        <span asp-validation-for="Nome"
                              class="admin-field-error">
                        </span>

                        <small>
                            Informe um nome para identificar a categoria.
                        </small>

                    </div>


                    <div class="admin-form-divider"></div>


                    <div class="admin-form-footer">

                        <a asp-action="Categorias"
                           class="admin-btn admin-btn-dark">

                            <i class="bi bi-arrow-left"></i>
                            Cancelar

                        </a>


                        <button type="submit"
                                class="admin-btn admin-btn-primary">

                            <i class="bi bi-check-lg"></i>
                            Cadastrar Categoria

                        </button>

                    </div>

                </form>

            </section>

        </main>

    </div>


    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>