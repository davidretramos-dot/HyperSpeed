@using HyperSpeed.UI.Models

@model ProdutoFormViewModel

@{
    Layout = null;
    ViewData["Title"] = "Cadastrar Novo Produto";
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HyperSpeed Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.googleapis.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <div class="admin">

        <!-- SIDEBAR -->

        <aside class="admin-sidebar">

            <div class="admin-brand">

                <div class="admin-brand-icon">
                    <i class="bi bi-speedometer2"></i>
                </div>

                <div>
                    <strong>HYPER</strong>
                    <span>SPEED</span>
                </div>

            </div>


            <div class="admin-menu-title">
                ADMINISTRAÇÃO
            </div>


            <nav class="admin-menu">

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-menu-item">

                    <i class="bi bi-grid-1x2-fill"></i>
                    <span>Dashboard</span>

                </a>


                <a asp-controller="Admin"
                   asp-action="Produtos"
                   class="admin-menu-item active">

                    <i class="bi bi-box-seam-fill"></i>
                    <span>Produtos</span>

                </a>


                <a asp-controller="Admin"
                   asp-action="Categorias"
                   class="admin-menu-item">

                    <i class="bi bi-tags-fill"></i>
                    <span>Categorias</span>

                </a>


                <a asp-controller="Pedido"
                   asp-action="Index"
                   class="admin-menu-item">

                    <i class="bi bi-cart-fill"></i>
                    <span>Pedidos</span>

                </a>

            </nav>


            <div class="admin-sidebar-bottom">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="admin-menu-item">

                    <i class="bi bi-arrow-left-circle-fill"></i>
                    <span>Voltar ao Site</span>

                </a>

            </div>

        </aside>


        <!-- CONTEÚDO -->

        <main class="admin-content">

            <header class="admin-header">

                <div>

                    <span class="admin-header-label">
                        HYPERSPEED / PRODUTOS
                    </span>

                    <h1>Novo Produto</h1>

                    <p>
                        Cadastre um novo produto no catálogo da loja.
                    </p>

                </div>

                <div class="admin-header-icon">
                    <i class="bi bi-box-seam-fill"></i>
                </div>

            </header>


            <!-- FORMULÁRIO -->

            <section class="admin-form-section">

                <div class="admin-form-header">

                    <div class="admin-form-title">

                        <div class="admin-form-icon">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>

                        <div>

                            <span class="section-label">
                                CATÁLOGO
                            </span>

                            <h2>Informações do produto</h2>

                        </div>

                    </div>

                </div>


                <form asp-action="CreateProd"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="admin-validation mb-3">
                    </div>


                    <!-- NOME -->

                    <div class="admin-form-group">

                        <label asp-for="NomeProduto">
                            Nome do Produto
                        </label>

                        <div class="admin-input-wrapper">

                            <i class="bi bi-box"></i>

                            <input asp-for="NomeProduto"
                                   class="admin-input"
                                   placeholder="Ex: RTX 4080 Ti"
                                   required />

                        </div>

                        <span asp-validation-for="NomeProduto"
                              class="admin-field-error">
                        </span>

                    </div>


                    <!-- DESCRIÇÃO -->

                    <div class="admin-form-group">

                        <label asp-for="Descricao">
                            Descrição
                        </label>

                        <div class="admin-textarea-wrapper">

                            <i class="bi bi-card-text"></i>

                            <textarea asp-for="Descricao"
                                      class="admin-textarea"
                                      rows="5"
                                      placeholder="Descreva o produto, suas características e especificações..."
                                      required></textarea>

                        </div>

                        <span asp-validation-for="Descricao"
                              class="admin-field-error">
                        </span>

                    </div>


                    <!-- PREÇO / ESTOQUE / CATEGORIA -->

                    <div class="admin-form-grid">


                        <div class="admin-form-group">

                            <label asp-for="Preco">
                                Preço
                            </label>

                            <div class="admin-input-wrapper">

                                <i class="bi bi-currency-dollar"></i>

                                <input asp-for="Preco"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       class="admin-input"
                                       placeholder="0,00"
                                       required />

                            </div>

                            <span asp-validation-for="Preco"
                                  class="admin-field-error">
                            </span>

                        </div>


                        <div class="admin-form-group">

                            <label asp-for="Estoque">
                                Estoque
                            </label>

                            <div class="admin-input-wrapper">

                                <i class="bi bi-stack"></i>

                                <input asp-for="Estoque"
                                       type="number"
                                       min="0"
                                       class="admin-input"
                                       placeholder="0"
                                       required />

                            </div>

                            <span asp-validation-for="Estoque"
                                  class="admin-field-error">
                            </span>

                        </div>


                        <div class="admin-form-group">

                            <label asp-for="IdCategoria">
                                Categoria
                            </label>

                            <div class="admin-input-wrapper">

                                <i class="bi bi-tags"></i>

                                <select asp-for="IdCategoria"
                                        class="admin-select"
                                        required>

                                    <option value="">
                                        Selecione uma categoria
                                    </option>

                                    @foreach (var category in Model.Categorias)
                                    {
                                        <option value="@category.Id">
                                            @category.Nome
                                        </option>
                                    }

                                </select>

                            </div>

                            <span asp-validation-for="IdCategoria"
                                  class="admin-field-error">
                            </span>

                        </div>

                    </div>


                    <!-- IMAGEM -->

                    <div class="admin-form-group">

                        <label asp-for="ImagemUrl">
                            URL da Imagem de Capa
                        </label>

                        <div class="admin-input-wrapper">

                            <i class="bi bi-image"></i>

                            <input asp-for="ImagemUrl"
                                   class="admin-input"
                                   placeholder="https://exemplo.com/imagem.png" />

                        </div>

                        <span asp-validation-for="ImagemUrl"
                              class="admin-field-error">
                        </span>

                        <small>
                            Informe a URL da imagem que será exibida no catálogo.
                        </small>

                    </div>


                    <!-- DESTAQUE -->

                    <div class="admin-feature">

                        <div class="admin-feature-icon">
                            <i class="bi bi-star-fill"></i>
                        </div>

                        <div class="admin-feature-text">

                            <strong>
                                Produto em destaque
                            </strong>

                            <span>
                                Exibir este produto entre os destaques da loja.
                            </span>

                        </div>

                        <label class="admin-switch">

                            <input asp-for="Destaque"
                                   type="checkbox" />

                            <span class="admin-slider"></span>

                        </label>

                    </div>


                    <div class="admin-form-divider"></div>


                    <!-- BOTÕES -->

                    <div class="admin-form-footer">

                        <a asp-action="Produtos"
                           class="admin-btn admin-btn-dark">

                            <i class="bi bi-arrow-left"></i>
                            Cancelar

                        </a>


                        <button type="submit"
                                class="admin-btn admin-btn-primary">

                            <i class="bi bi-check-lg"></i>
                            Cadastrar Produto

                        </button>

                    </div>

                </form>

            </section>

        </main>

    </div>


    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>