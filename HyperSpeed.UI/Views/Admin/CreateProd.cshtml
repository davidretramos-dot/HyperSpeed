@using hyperSpeed.Application.ViewModels
@model ProdutoFormViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Novo Produto";
}

<div class="formHS-page">

    <div class="formHS">

        <div class="formHS-header">

            <span class="formHS-label">
                HYPERSPEED / PRODUTOS
            </span>

            <h1>Novo Produto</h1>

            <p>
                Cadastre um novo produto no catálogo.
            </p>

        </div>


        <form asp-controller="Admin"
              asp-action="CreateProd"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row g-3">

                <div class="col-12">

                    <label asp-for="NomeProduto"
                           class="form-label">

                        Nome do Produto

                    </label>

                    <input asp-for="NomeProduto"
                           class="form-control"
                           placeholder="Ex: Ryzen 7 7700X"
                           required />

                    <span asp-validation-for="NomeProduto"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-12">

                    <label asp-for="Descricao"
                           class="form-label">

                        Descrição

                    </label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="4"
                              placeholder="Descreva o produto..."
                              required></textarea>

                    <span asp-validation-for="Descricao"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-4">

                    <label asp-for="Preco"
                           class="form-label">

                        Preço

                    </label>

                    <input asp-for="Preco"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           required />

                </div>


                <div class="col-md-4">

                    <label asp-for="Estoque"
                           class="form-label">

                        Estoque

                    </label>

                    <input asp-for="Estoque"
                           type="number"
                           min="0"
                           class="form-control"
                           required />

                </div>


                <div class="col-md-4">

                    <label asp-for="IdCategoria"
                           class="form-label">

                        Categoria

                    </label>

                    <select asp-for="IdCategoria"
                            class="form-select"
                            required>

                        <option value="">
                            Selecione uma categoria
                        </option>

                        @foreach (var category in Model.Categorias)
                        {

                            <option value="@category.Id">
                                @category.Nome
                            </option>

                        }

                    </select>

                </div>


                <div class="col-12">

                    <label asp-for="ImagemUrl"
                           class="form-label">

                        URL da Imagem

                    </label>

                    <input asp-for="ImagemUrl"
                           class="form-control"
                           placeholder="https://exemplo.com/imagem.png" />

                </div>


                <div class="col-12">

                    <div class="form-check">

                        <input asp-for="Destaque"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="Destaque"
                               class="form-check-label">

                            <i class="bi bi-star-fill"></i>
                            Marcar como destaque

                        </label>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <div class="formHS-actions">

                <a asp-controller="Admin"
                   asp-action="Produtos"
                   class="admin-btn admin-btn-outline">

                    <i class="bi bi-arrow-left"></i>
                    Cancelar

                </a>


                <button type="submit"
                        class="admin-btn">

                    <i class="bi bi-check-lg"></i>
                    Cadastrar Produto

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}