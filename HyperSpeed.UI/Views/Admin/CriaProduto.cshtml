
@using HyperSpeed.UI.Models
@model ProdutoFormViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Cadastrar Novo Produto";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-senac">
            <form asp-action="CreateProd" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="NomeProduto" class="form-label">Nome do Produto</label>
                        <input asp-for="NomeProduto" class="form-control" placeholder="Ex: 4080 Ti" required />
                        <span asp-validation-for="NomeProduto" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Descricao" class="form-label">Descrição</label>
                        <textarea asp-for="Descricao" class="form-control" rows="4" placeholder="Descreva o Produto..." required></textarea>
                        <span asp-validation-for="Descricao" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Preco" class="form-label">Preço</label>
                        <input asp-for="Preco" type="number" class="form-control" min="0" required />
                        <span asp-validation-for="Preco" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Estoque" class="form-label">Estoque</label>
                        <input asp-for="Estoque" type="number" class="form-control" min="0" required />
                        <span asp-validation-for="Estoque" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="IdCategoria" class="form-label">Categoria</label>
                        <select asp-for="IdCategoria" class="form-select" required>
                            <option value="">Selecione uma categoria</option>
                            @foreach (var category in Model.Categorias)
                            {
                                <option value="@category.Id">@category.Nome</option>
                            }
                        </select>
                        <span asp-validation-for="IdCategoria" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ImagemUrl" class="form-label">URL da Imagem de Capa</label>
                        <input asp-for="ImagemUrl" class="form-control" placeholder="https://exemplo.com/imagem.png" />
                        <span asp-validation-for="ImagemUrl" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="Destaque" class="form-check-input" type="checkbox" />
                            <label asp-for="Destaque" class="form-check-label">
                                <i class="bi bi-star-fill text-warning"></i> Marcar como destaque
                            </label>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />
                <div class="d-flex justify-content-between">
                    <a asp-action="Produtos" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary-senac">
                        <i class="bi bi-check-lg"></i> Cadastrar Produto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
