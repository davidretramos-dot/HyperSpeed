@* Confirmar Exclusão de Categoria *@
@model CategoriasDTo
@{
    Layout = "_AdminLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-senac text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
            <h4 class="mt-3">Confirmar Exclusão</h4>
            <p class="text-muted-senac">Deseja realmente excluir a categoria abaixo?</p>

            <div class="rounded p-3 my-3" style="background-color: var(--surface-container-high);">
                <h5 class="mb-1">@Model.Nome</h5>
                <small class="text-muted-senac">ID: @Model.Id</small>
            </div>

            @* Mensagem informativa — validação final é feita no servidor (TempData["Error"]) *@
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle"></i>
                    @TempData["Error"]
                </div>
            }
            else
            {
                <div class="alert alert-secondary">
                    <i class="bi bi-info-circle"></i>
                    A exclusão será verificada no servidor. Caso existam games associados, a exclusão não será permitida.
                </div>
            }

            <div class="d-flex justify-content-center gap-3 mt-3">
                <a asp-action="Categorias" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>

                <form asp-action="DeleteCategoriaConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Excluir Categoria
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>