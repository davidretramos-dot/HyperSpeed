@using hyperSpeed.Application.DTOs

@model ProdutoDTo

@{

    Layout = "_AdminLayout";

    ViewData["Title"] = "Excluir Produto";

}

<div class="admin-form-page">

    <div class="admin-form-container">

        <div class="form-HS delete-product-card">

            <div class="form-header">

                <span class="form-label">

                    HYPERSPEED / PRODUTOS
                </span>

                <h1>
                    <i class="bi bi-trash3"></i>

                    Excluir Produto
                </h1>

                <p>

                    Você está prestes a excluir este produto.
                </p>

            </div>

 
            <div class="delete-warning">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>

                    <strong>Atenção!</strong>

                    <p>

                        Esta ação não poderá ser desfeita.
                    </p>

                </div>

            </div>

 
            <div class="delete-product-info">

                @if (!string.IsNullOrWhiteSpace(Model.ImagemUrl))

                {
                    <div class="delete-product-image">

                        <img src="@Model.ImagemUrl"
                             alt="@Model.NomeProduto"
                             onerror="this.style.display='none'" />

                    </div>

                }

 
                <div class="delete-product-details">

                    <h2>@Model.NomeProduto</h2>

                    <p class="delete-description">

                        @Model.Descricao
                    </p>

 
                    <div class="delete-product-data">

                        <div>

                            <span>Preço</span>

                            <strong>

                                R$ @Model.Preco.ToString("N2")
                            </strong>

                        </div>

 
                        <div>

                            <span>Estoque</span>

                            <strong>

                                @Model.Estoque unidades
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

 
            <form asp-controller="Admin"
                  asp-action="DeleteProdConfirmed"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

 
                <div class="form-actions">

                    <a asp-controller="Admin"
                       asp-action="Produtos"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>

                        Cancelar

                    </a>

 
                    <button type="submit"
                            class="btn-delete-product">

                        <i class="bi bi-trash3"></i>

                        Excluir Produto

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

 