@model ProdutoDTo
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Excluir Produto";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-senac text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
            <h4 class="mt-3">Confirmar Exclusão</h4>
            <p class="text-muted-senac">Deseja realmente excluir o Produto abaixo?</p>

            <div class="rounded p-3 my-3" style="background-color: var(--surface-container-high);">
                <h5 class="mb-1">@Model.NomeProduto</h5>
                <small class="text-muted-senac">@Model.NomeCategoria • @Model.CriacaoAt.ToString("yyyy")</small>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Produtos" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancelar
                </a>

                <form asp-action="DeleteProdConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Excluir Produto
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>