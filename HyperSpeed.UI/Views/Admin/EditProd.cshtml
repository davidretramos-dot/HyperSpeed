@using HyperSpeed.UI.Models

@model ProdutoFormViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Editar Produto";
}

<div class="admin-form-page">

    <div class="admin-form-container">

        <div class="formHS">

            <div class="form-header">
                <span class="form-label">
                    HYPERSPEED / PRODUTOS
                </span>

                <h1>Editar Produto</h1>

                <p>
                    Altere as informações do produto abaixo.
                </p>
            </div>

            <form asp-controller="Admin"
                  asp-action="EditProd"
                  method="post">

                @Html.AntiForgeryToken()

                @* Se o ViewModel possuir Id *@
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- NOME -->
                    <div class="col-12">

                        <label asp-for="NomeProduto"
                               class="form-label">
                            Nome do Produto
                        </label>

                        <input asp-for="NomeProduto"
                               class="form-control"
                               placeholder="Ex: Ryzen 7 7700X"
                               required />

                        <span asp-validation-for="NomeProduto"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- DESCRIÇÃO -->
                    <div class="col-12">

                        <label asp-for="Descricao"
                               class="form-label">
                            Descrição
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Descreva o produto..."
                                  required></textarea>

                        <span asp-validation-for="Descricao"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PREÇO -->
                    <div class="col-md-4">

                        <label asp-for="Preco"
                               class="form-label">
                            Preço
                        </label>

                        <input asp-for="Preco"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               required />

                        <span asp-validation-for="Preco"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ESTOQUE -->
                    <div class="col-md-4">

                        <label asp-for="Estoque"
                               class="form-label">
                            Estoque
                        </label>

                        <input asp-for="Estoque"
                               type="number"
                               min="0"
                               class="form-control"
                               required />

                        <span asp-validation-for="Estoque"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CATEGORIA -->
                    <div class="col-md-4">

                        <label asp-for="IdCategoria"
                               class="form-label">
                            Categoria
                        </label>

                        <select asp-for="IdCategoria"
                                class="form-select"
                                required>

                            <option value="">
                                Selecione uma categoria
                            </option>

                            @foreach (var categoria in Model.Categorias)
                            {
                                <option value="@categoria.Id">
                                    @categoria.Nome
                                </option>
                            }

                        </select>

                        <span asp-validation-for="IdCategoria"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- IMAGEM -->
                    <div class="col-12">

                        <label asp-for="ImagemUrl"
                               class="form-label">
                            URL da Imagem
                        </label>

                        <input asp-for="ImagemUrl"
                               class="form-control"
                               placeholder="https://exemplo.com/imagem.png" />

                        <span asp-validation-for="ImagemUrl"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- DESTAQUE -->
                    <div class="col-12">

                        <div class="form-check">

                            <input asp-for="Destaque"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="Destaque"
                                   class="form-check-label">

                                <i class="bi bi-star-fill"></i>
                                Marcar como destaque

                            </label>

                        </div>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- BOTÕES -->

                <div class="form-actions">

                    <a asp-controller="Admin"
                       asp-action="Produtos"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>
                        Cancelar

                    </a>

                    <button type="submit"
                            class="btn btn-primary-senac">

                        <i class="bi bi-check-lg"></i>
                        Salvar Alterações

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}