@using hyperSpeed.Application.ViewModels

@model DashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Painel Administrativo";
}

<div class="admin-page-header">

    <div>

        <span class="admin-page-label">
            HYPERSPEED / ADMIN
        </span>

        <h1>Painel Administrativo</h1>

        <p class="admin-page-description">
            Gerencie produtos, categorias e pedidos da loja.
        </p>

    </div>

    <div class="admin-card-icon">
        <i class="bi bi-person-circle"></i>
    </div>

</div>


<div class="admin-cards">

    <div class="admin-card">

        <div class="admin-card-icon">
            <i class="bi bi-box-seam-fill"></i>
        </div>

        <div>

            <h3>Produtos</h3>

            <span>
                @(Model?.TotalProdutos ?? 0)
            </span>

        </div>

    </div>


    <div class="admin-card">

        <div class="admin-card-icon">
            <i class="bi bi-tags-fill"></i>
        </div>

        <div>

            <h3>Categorias</h3>

            <span>
                @(Model?.TotalCategorias ?? 0)
            </span>

        </div>

    </div>


    <div class="admin-card">

        <div class="admin-card-icon">
            <i class="bi bi-cart-fill"></i>
        </div>

        <div>

            <h3>Pedidos</h3>

            <span>—</span>

        </div>

    </div>

</div>


<div class="admin-panel">

    <div class="admin-panel-header">

        <div>

            <span>ATALHOS</span>

            <h2>Ações rápidas</h2>

        </div>

    </div>


    <div class="admin-actions">

        <a asp-controller="Admin"
           asp-action="Index"
           class="admin-btn">

            <i class="bi bi-speedometer2"></i>
            Dashboard

        </a>


        <a asp-controller="Admin"
           asp-action="CreateProd"
           class="admin-btn">

            <i class="bi bi-plus-circle-fill"></i>
            Novo Produto

        </a>


        <a asp-controller="Admin"
           asp-action="CreateCategoria"
           class="admin-btn admin-btn-outline">

            <i class="bi bi-folder-plus"></i>
            Nova Categoria

        </a>

    </div>

</div>


<div class="admin-panel">

    <div class="admin-panel-header">

        <div>

            <span>CATÁLOGO</span>

            <h2>Produtos Recentes</h2>

        </div>

        <a asp-controller="ProdutoAdmin"
           asp-action="Index"
           class="admin-btn-outline">

            Ver todos →

        </a>

    </div>


    @if (Model?.RecentProdutos != null &&
         Model.RecentProdutos.Any())
    {

        <div class="admin-table-wrapper">

            <table class="admin-table">

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Criado Em</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var p in Model.RecentProdutos)
                    {

                        <tr>

                            <td>
                                #@p.Id
                            </td>

                            <td>
                                <strong>
                                    @p.NomeProduto
                                </strong>
                            </td>

                            <td>
                                @p.NomeCategoria
                            </td>

                            <td>
                                @p.CriacaoAt.ToString("dd/MM/yyyy")
                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    }
    else
    {

        <p>
            Nenhum produto recente encontrado.
        </p>

    }

</div>