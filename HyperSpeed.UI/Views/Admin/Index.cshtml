@model HyperSpeed.UI.Controllers.AdminController.DashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Painel Administrativo";
}

<div class="admin">
    <aside class="admin-sidebar">
        <h2>ADMIN</h2>
        <a asp-controller="Admin" asp-action="Index">Dashboard</a>
        <a asp-controller="Admin" asp-action="Produtos">Produtos</a>
        <a asp-controller="Admin" asp-action="Categorias">Categorias</a>
        <a asp-controller="Pedido" asp-action="Index">Pedidos</a>
        <a asp-controller="Home" asp-action="Index">Voltar ao Site</a>
    </aside>

    <main class="admin-content">
        <h1>@ViewData["Title"]</h1>

        <div class="admin-cards">
            <div class="admin-card">
                <h3>Produtos</h3>
                <span>@(Model?.TotalProdutos ?? 0)</span>
            </div>

            <div class="admin-card">
                <h3>Categorias</h3>
                <span>@(Model?.TotalCategorias ?? 0)</span>
            </div>

            <div class="admin-card">
                <h3>Pedidos</h3>
                <span>—</span>
            </div>
        </div>

        <div class="admin-actions">
            <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-speedometer2"></i> Ir para Dashboard
            </a>
            <a asp-controller="Admin" asp-action="CreateProd" class="btn btn-primary ms-2">Novo Produto</a>
            <a asp-controller="Admin" asp-action="CreateCategoria" class="btn btn-outline-primary ms-2">Nova Categoria</a>
        </div>

        <h2 class="mt-4">Produtos Recentes</h2>

        @if (Model?.RecentProdutos != null && Model.RecentProdutos.Any())
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Criado Em</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.RecentProdutos)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.NomeProduto</td>
                            <td>@p.NomeCategoria</td>
                            <td>@p.CriacaoAt.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted-senac">Nenhum produto recente encontrado.</p>
        }
    </main>
</div>