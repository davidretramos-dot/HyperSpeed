@model HyperSpeed.UI.Controllers.AdminController.DashboardViewModel

@{
    Layout = null;
    ViewData["Title"] = "Painel Administrativo";
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HyperSpeed</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true">

</head>
<body>
<div class="admin">

    <aside class="admin-sidebar">

        <div class="admin-brand">
            <div class="admin-brand-icon">
                <i class="bi bi-speedometer2"></i>
            </div>

            <div>
                <strong>HYPER</strong>
                <span>SPEED</span>
            </div>
        </div>

        <div class="admin-menu-title">
            ADMINISTRAÇÃO
        </div>

        <nav class="admin-menu">

            <a asp-controller="Admin"
               asp-action="Index"
               class="admin-menu-item active">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>Dashboard</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Produtos"
               class="admin-menu-item">
                <i class="bi bi-box-seam-fill"></i>
                <span>Produtos</span>
            </a>

            <a asp-controller="Admin"
               asp-action="Categorias"
               class="admin-menu-item">
                <i class="bi bi-tags-fill"></i>
                <span>Categorias</span>
            </a>

            <a asp-controller="Pedido"
               asp-action="Index"
               class="admin-menu-item">
                <i class="bi bi-cart-fill"></i>
                <span>Pedidos</span>
            </a>

        </nav>

        <div class="admin-sidebar-bottom">

            <a asp-controller="Home"
               asp-action="Index"
               class="admin-menu-item">
                <i class="bi bi-arrow-left-circle-fill"></i>
                <span>Voltar ao Site</span>
            </a>

        </div>

    </aside>


    <main class="admin-content">

        <header class="admin-header">

            <div>
                <span class="admin-header-label">
                    HYPERSPEED / ADMIN
                </span>

                <h1>Painel Administrativo</h1>

                <p>
                    Gerencie produtos, categorias e pedidos da loja.
                </p>
            </div>

            <div class="admin-header-icon">
                <i class="bi bi-person-circle"></i>
            </div>

        </header>


        <!-- CARDS -->

        <section class="admin-cards">

            <div class="admin-card">

                <div class="admin-card-icon">
                    <i class="bi bi-box-seam-fill"></i>
                </div>

                <div class="admin-card-info">
                    <h3>Produtos</h3>

                    <span>
                        @(Model?.TotalProdutos ?? 0)
                    </span>

                    <small>produtos cadastrados</small>
                </div>

            </div>


            <div class="admin-card">

                <div class="admin-card-icon">
                    <i class="bi bi-tags-fill"></i>
                </div>

                <div class="admin-card-info">
                    <h3>Categorias</h3>

                    <span>
                        @(Model?.TotalCategorias ?? 0)
                    </span>

                    <small>categorias cadastradas</small>
                </div>

            </div>


            <div class="admin-card">

                <div class="admin-card-icon">
                    <i class="bi bi-cart-check-fill"></i>
                </div>

                <div class="admin-card-info">
                    <h3>Pedidos</h3>

                    <span>—</span>

                    <small>pedidos realizados</small>
                </div>

            </div>

        </section>


        <!-- AÇÕES -->

        <section class="admin-section">

            <div class="admin-section-header">

                <div>
                    <span class="section-label">ATALHOS</span>
                    <h2>Ações rápidas</h2>
                </div>

            </div>


            <div class="admin-actions">

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-btn admin-btn-dark">

                    <i class="bi bi-speedometer2"></i>

                    <span>Dashboard</span>

                </a>


                <a asp-controller="Admin"
                   asp-action="CreateProd"
                   class="admin-btn admin-btn-primary">

                    <i class="bi bi-plus-circle-fill"></i>

                    <span>Novo Produto</span>

                </a>


                <a asp-controller="Admin"
                   asp-action="CreateCategoria"
                   class="admin-btn admin-btn-outline">

                    <i class="bi bi-folder-plus"></i>

                    <span>Nova Categoria</span>

                </a>

            </div>

        </section>


        <!-- PRODUTOS RECENTES -->

        <section class="admin-section products-section">

            <div class="admin-section-header">

                <div>
                    <span class="section-label">CATÁLOGO</span>
                    <h2>Produtos Recentes</h2>
                </div>

                <a asp-controller="Admin"
                   asp-action="Produtos"
                   class="view-all">
                    Ver todos
                    <i class="bi bi-arrow-right"></i>
                </a>

            </div>


            @if (Model?.RecentProdutos != null && Model.RecentProdutos.Any())
            {
                <div class="admin-table-wrapper">

                    <table class="admin-table">

                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Produto</th>
                                <th>Categoria</th>
                                <th>Criado Em</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var p in Model.RecentProdutos)
                            {
                                <tr>

                                    <td>
                                        <span class="product-id">
                                            #@p.Id
                                        </span>
                                    </td>

                                    <td>
                                        <div class="product-name">
                                            <div class="product-icon">
                                                <i class="bi bi-box-seam"></i>
                                            </div>

                                            <strong>
                                                @p.NomeProduto
                                            </strong>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="category-badge">
                                            @p.NomeCategoria
                                        </span>
                                    </td>

                                    <td>
                                        <span class="date">
                                            @p.CriacaoAt.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-box-seam"></i>

                    <h3>Nenhum produto recente</h3>

                    <p>
                        Ainda não existem produtos cadastrados no sistema.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="CreateProd"
                       class="admin-btn admin-btn-primary">
                        <i class="bi bi-plus-circle"></i>
                        Cadastrar produto
                    </a>

                </div>
            }

        </section>

    </main>

</div>
</body>