@model IEnumerable<ProdutoDTo>

@{
    Layout = null;
    ViewData["Title"] = "Gerenciar Produtos";
}
<head>
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<div class="admin-page">

    <!-- CABEÇALHO -->

    <div class="admin-header">

        <div>

            <span class="admin-header-label">
                HYPERSPEED / PRODUTOS
            </span>

            <h1>Gerenciar Produtos</h1>

            <p>
                Consulte, edite e gerencie os produtos cadastrados na loja.
            </p>

        </div>

        <div class="admin-header-actions">

            <div class="admin-header-icon">
                <i class="bi bi-box-seam-fill"></i>
            </div>

            <a asp-action="Create"
               class="admin-btn admin-btn-primary">

                <i class="bi bi-plus-lg"></i>

                Novo Produto

            </a>

        </div>

    </div>


    <!-- ÁREA DE PRODUTOS -->

    <div class="admin-section products-section">


        <!-- CABEÇALHO DA LISTAGEM -->

        <div class="admin-section-header">

            <div>

                <span class="section-label">
                    CATÁLOGO
                </span>

                <h2>Produtos cadastrados</h2>

            </div>

            <span class="admin-count">

                @(Model?.Count() ?? 0) produtos

            </span>

        </div>


        <!-- PESQUISA -->

        <div class="admin-search">

            <div class="admin-search-wrapper">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="productSearch"
                       placeholder="Pesquisar produto..." />

            </div>

        </div>


        <!-- TABELA -->
        @if (Model != null && Model.Any())
        {
            <div class="admin-table-wrapper">

                <table class="admin-table"
                       id="productsTable">

                    <thead>

                        <tr>

                            <th>Imagem</th>

                            <th>Produto</th>

                            <th>Categoria</th>

                            <th>Preço</th>

                            <th>Estoque</th>

                            <th>Ações</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var produto in Model)
                        {
                            <tr>

                                <!-- IMAGEM -->

                                <td>

                                    <div class="produto-admin-img-container">

                                        @if (!string.IsNullOrEmpty(produto.ImagemUrl))
                                        {
                                            <img src="@produto.ImagemUrl"
                                                 alt="@produto.NomeProduto"
                                                 class="produto-admin-img" />
                                        }
                                        else
                                        {
                                            <div class="produto-admin-placeholder">

                                                <i class="bi bi-image"></i>

                                            </div>
                                        }

                                    </div>

                                </td>


                                <!-- PRODUTO -->

                                <td>

                                    <div class="admin-product-name">

                                        <strong>
                                            @produto.NomeProduto
                                        </strong>

                                    </div>

                                </td>


                                <!-- CATEGORIA -->

                                <td>

                                    <span class="category-badge">
                                        @produto.NomeCategoria
                                    </span>

                                </td>


                                <!-- PREÇO -->

                                <td>

                                    <span class="product-price">
                                        R$ @produto.Preco.ToString("N2")
                                    </span>

                                </td>


                                <!-- ESTOQUE -->

                                <td>

                                    @if (produto.Estoque <= 0)
                                    {
                                        <span class="stock-badge stock-empty">
                                            Sem estoque
                                        </span>
                                    }
                                    else if (produto.Estoque <= 5)
                                    {
                                        <span class="stock-badge stock-low">
                                            @produto.Estoque unidades
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge stock-ok">
                                            @produto.Estoque unidades
                                        </span>
                                    }

                                </td>


                                <!-- AÇÕES -->

                                <td>

                                    <div class="product-actions">

                                        <a asp-action="Edit"
                                           asp-route-id="@produto.Id"
                                           class="product-action-edit">

                                            <i class="bi bi-pencil-fill"></i>

                                            Editar

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@produto.Id"
                                           class="product-action-delete">

                                            <i class="bi bi-trash-fill"></i>

                                            Excluir

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <!-- NENHUM PRODUTO -->

            <div class="empty-state">

                <i class="bi bi-box-seam"></i>

                <h3>Nenhum produto encontrado</h3>

                <p>
                    Ainda não existem produtos cadastrados no sistema.
                </p>

                <a asp-action="Create"
                   class="admin-btn admin-btn-primary">

                    <i class="bi bi-plus-circle"></i>

                    Cadastrar primeiro produto

                </a>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("productSearch");

            const table =
                document.getElementById("productsTable");

            if (!searchInput || !table)
                return;

            searchInput.addEventListener("input", function () {

                const search =
                    this.value.toLowerCase().trim();

                const rows =
                    table.querySelectorAll("tbody tr");

                rows.forEach(function (row) {

                    const text =
                        row.textContent.toLowerCase();

                    row.style.display =
                        text.includes(search)
                            ? ""
                            : "none";

                });

            });

        });

    </script>

}