@using System.Linq

@using hyperSpeed.Application.DTOs

@model List<ProdutoDTo>

@{

    Layout = "_AdminLayout";

    ViewData["Title"] = "Gerenciar Produtos";

}

<div class="admin-page-header">

    <div>

        <span class="admin-page-label">

            HYPERSPEED / PRODUTOS
        </span>

        <h1>Produtos</h1>

        <p class="admin-page-description">

            Gerencie os produtos cadastrados na loja.
        </p>

    </div>

    <a asp-controller="Admin"
       asp-action="CreateProd"
       class="admin-btn">

        <i class="bi bi-plus-lg"></i>

        Novo Produto

    </a>

</div>

 
<div class="admin-search">

    <input type="text"
           placeholder="Pesquisar produto..." />

</div>

 
<div class="admin-panel">

    <div class="admin-table-wrapper">

        <table class="admin-table">

            <thead>

                <tr>

                    <th>Imagem</th>
                    <th>Produto</th>
                    <th>Categoria</th>
                    <th>Preço</th>
                    <th>Estoque</th>
                    <th>Ações</th>

                </tr>

            </thead>

 
            <tbody>

                @if (Model != null && Model.Any())

                {

                    @foreach (var produto in Model)

                    {
                        <tr>

                            <td>

                                <img src="@produto.ImagemUrl"
                                     class="produto-admin-img"
                                     alt="@produto.NomeProduto" />

                            </td>

 
                            <td>

                                <strong>

                                    @produto.NomeProduto
                                </strong>

                            </td>

 
                            <td>

                                @produto.NomeCategoria

                            </td>

 
                            <td>

                                R$ @produto.Preco.ToString("N2")

                            </td>

 
                            <td>

                                @produto.Estoque

                            </td>

 
                            <td>

                                <a asp-controller="Admin"
                                   asp-action="EditProd"
                                   asp-route-id="@produto.Id"
                                   class="btn-editar">

                                    Editar

                                </a>

 
                                <a asp-controller="Admin"
                                   asp-action="DeleteProd"
                                   asp-route-id="@produto.Id"
                                   class="btn-excluir">

                                    Excluir

                                </a>

                            </td>

                        </tr>

                    }

                }

                else

                {
                    <tr>

                        <td colspan="6">

                            Nenhum produto encontrado.

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

</div>

 