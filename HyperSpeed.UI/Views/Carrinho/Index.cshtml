@model List<hyperSpeed.Application.ViewModels.CarrinhoItem>

@{
    ViewData["Title"] = "Meu Carrinho";
}

<div class="carrinho-page">

    <div class="carrinho-header">
        <div>
            <span class="carrinho-label">HYPERSPEED / PEDIDO</span>
            <h1>Meu Carrinho</h1>
            <p>Confira os produtos que você adicionou.</p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="carrinho-continuar">
            <i class="bi bi-arrow-left"></i>
            Continuar comprando
        </a>
    </div>

 
    @if (Model == null || !Model.Any())
    {
        <div class="carrinho-vazio">

            <div class="carrinho-vazio-icon">
                <i class="bi bi-cart-x"></i>
            </div>

            <h2>Seu carrinho está vazio</h2>

            <p>
                Você ainda não adicionou nenhum produto ao seu carrinho.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="carrinho-btn">
                <i class="bi bi-shop"></i>
                Ver produtos
            </a>

        </div>
    }
    else
    {
        <div class="carrinho-layout">

            <!-- PRODUTOS -->

            <div class="carrinho-produtos">

                @foreach (var item in Model)
                {
                    <div class="carrinho-item">

                        <div class="carrinho-item-icon">
                            <i class="bi bi-cpu"></i>
                        </div>

                        <div class="carrinho-item-info">

                            <h3>@item.Nome</h3>

                            <span>
                                Produto HyperSpeed
                            </span>

                            <div class="carrinho-preco">
                                R$ @item.Preco.ToString("N2")
                            </div>

                        </div>

                        <div class="carrinho-quantidade">

                            <span>QUANTIDADE</span>

                            <strong>
                                @item.Quantidade
                            </strong>

                        </div>

                        <div class="carrinho-subtotal">

                            <span>SUBTOTAL</span>

                            <strong>
                                R$ @item.SubTotal.ToString("N2")
                            </strong>

                        </div>

                        <form asp-action="Remover"
                              method="post">

                            <input type="hidden"
                                   name="produtoId"
                                   value="@item.ProdutoId" />

                            <button type="submit"
                                    class="carrinho-remover"
                                    title="Remover produto">

                                <i class="bi bi-trash3"></i>

                            </button>

                        </form>

                    </div>
                }

            </div>

 
            <!-- RESUMO -->

            <aside class="carrinho-resumo">

                <span class="carrinho-label">
                    RESUMO DO PEDIDO
                </span>

                <h2>Seu pedido</h2>

                <div class="resumo-linha">
                    <span>Produtos</span>
                    <strong>@Model.Count</strong>
                </div>

                <div class="resumo-linha">
                    <span>Frete</span>
                    <strong>Grátis</strong>
                </div>

                <div class="resumo-divisor"></div>

                <div class="resumo-total">

                    <span>Total</span>

                    <strong>
                        R$ @ViewBag.Total.ToString("N2")
                    </strong>

                </div>

                <button class="carrinho-finalizar"
                        type="button">

                    Finalizar pedido
                    <i class="bi bi-arrow-right"></i>

                </button>

            </aside>

        </div>
    }

</div>