@using hyperSpeed.Application.ViewModels
@model List<CarrinhoItem>

@{
    ViewData["Title"] = "Meu Carrinho";
}

<div class="carrinho-page">

    <div class="carrinho-header">
        <h1>Meu Carrinho</h1>
        <p>Confira os produtos que você adicionou.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="carrinho-vazio">
            <i class="bi bi-cart-x"></i>

            <h2>Seu carrinho está vazio</h2>

            <p>
                Adicione alguns produtos para continuar.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="carrinho-voltar">
                Continuar comprando
            </a>
        </div>
    }
    else
    {
        <div class="carrinho-conteudo">

            <div class="carrinho-itens">

                @foreach (var item in Model)
                {
                    <div class="carrinho-item">

                        <div class="carrinho-item-info">

                            <div>
                                <h3>@item.Nome</h3>

                                <span>
                                    R$ @item.Preco.ToString("N2")
                                </span>
                            </div>

                        </div>

                        <div class="carrinho-item-quantidade">
                            <span>
                                Quantidade: @item.Quantidade
                            </span>
                        </div>

                        <div class="carrinho-item-subtotal">
                            <strong>
                                R$ @item.SubTotal.ToString("N2")
                            </strong>
                        </div>

                        <form asp-controller="Carrinho"
                              asp-action="Remover"
                              method="post">

                            <input type="hidden"
                                   name="produtoId"
                                   value="@item.ProdutoId" />

                            <button type="submit"
                                    class="carrinho-remover">
                                <i class="bi bi-trash"></i>
                            </button>

                        </form>

                    </div>
                }
                            <a asp-controller="Home"
                               asp-action="Index"
                               class="carrinho-voltar">
                                Continuar comprando
                            </a>

            </div>

            <div class="carrinho-resumo">

                <h2>Resumo do pedido</h2>

                <div class="carrinho-total">
                    <span>Total</span>

                    <strong>
                        R$ @ViewBag.Total.ToString("N2")
                    </strong>
                </div>

                <form asp-controller="Carrinho"
                      asp-action="FinalizarPedido"
                      method="post">

                    <button type="submit" class="carrinho-finalizar">
                        <i class="bi bi-check-circle"></i>
                        Finalizar pedido
                    </button>

                </form>

            </div>

        </div>
    }

</div>