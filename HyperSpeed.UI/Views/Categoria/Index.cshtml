@using hyperSpeed.Application.DTOs
@model IEnumerable<CategoriasDTo>

@{
    ViewData["Title"] = "Categorias";
}

<div class="categoria-page">

    <div class="categoria-header">
        <span class="categoria-label">HYPERSPEED STORE</span>

        <h1>Explore nossas categorias</h1>

        <p>
            Encontre os produtos que você procura navegando pelas nossas categorias.
        </p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="categoria-grid">

            @foreach (var categoria in Model)
            {
                <div class="categoria-card">

                    <div class="categoria-card-icon">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </div>

                    <div class="categoria-card-content">

   
                        @if (!string.IsNullOrWhiteSpace(categoria.Nome))
                        {
                            <p>@categoria.Nome</p>
                        }
                        else
                        {
                            <p>Confira os produtos desta categoria.</p>
                        }
                    </div>

                </div>

            }

        </div>
    }
    else
    {
        <div class="categoria-empty">
            <i class="bi bi-inbox"></i>

            <h2>Nenhuma categoria encontrada</h2>

            <p>
                Ainda não existem categorias cadastradas.
            </p>
        </div>
    }

</div>