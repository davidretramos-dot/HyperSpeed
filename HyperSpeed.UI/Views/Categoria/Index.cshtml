@using hyperSpeed.Application.ViewModels

@model CategoriaListViewModel

@{
    ViewData["Title"] = "Categorias";
}

<div class="categoria-page">

    <div class="categoria-header">
        <span class="categoria-label">HYPERSPEED STORE</span>

        <h1>Explore nossas categorias</h1>

        <p>
            Encontre os produtos que você procura navegando pelas nossas categorias.
        </p>
    </div>

    @if (Model.Categorias != null && Model.Categorias.Any())
    {
        <div class="categoria-grid">

            @foreach (var categoria in Model.Categorias)
            {
                var total = Model.TotalDe(categoria.Id);

                <a asp-controller="Categoria"
                   asp-action="Produtos"
                   asp-route-id="@categoria.Id"
                   class="categoria-card">

                    <div class="categoria-card-icon">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </div>

                    <div class="categoria-card-content">

                        <p>
                            @(string.IsNullOrWhiteSpace(categoria.Nome)
                                ? "Categoria"
                                : categoria.Nome)
                        </p>

                        <span class="categoria-card-count">
                            @total @(total == 1 ? "produto" : "produtos")
                        </span>

                    </div>

                    <i class="bi bi-chevron-right categoria-card-seta"></i>

                </a>
            }

        </div>
    }
    else
    {
        <div class="categoria-empty">
            <i class="bi bi-inbox"></i>

            <h2>Nenhuma categoria encontrada</h2>

            <p>
                Ainda não existem categorias cadastradas.
            </p>
        </div>
    }

</div>
