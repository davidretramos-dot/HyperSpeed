@{
    ViewData["Title"] = "Home";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="icon"
      type="image/png"
      href="img/Icone HS.png">

<!-- =====================================================
     BANNER
     ===================================================== -->

<section class="banner">

    <div class="banner-overlay"></div>

    @* <img src="~/img/BannerIndexRemake.png"
         alt="HyperSpeed - Ofertas em hardware"
         class="banner-img"> *@

    <div class="banner-content">

        <span class="banner-tag">
            HYPERSPEED
        </span>

        <h1>
            MONTE O PC<br>
            <strong>DOS SEUS SONHOS.</strong>
        </h1>

        <p>
            Hardware de alta performance pelo melhor preço.
        </p>

        <a href="#produtos"
           class="banner-button">

            <i class="bi bi-cart-fill"></i>
            Conferir produtos

        </a>

    </div>

</section>


<!-- =====================================================
     SLOGAN
     ===================================================== -->

<section class="slogan">

    <div class="slogan-line"></div>

    <p>
        Tudo do bom e mais barato
    </p>

    <h1>
        CONFIRA!
    </h1>

    <span>
        Encontre os melhores componentes para seu setup.
    </span>

    <div class="slogan-line"></div>

</section>


<!-- =====================================================
     MONTE SEU PC
     ===================================================== -->

<section class="categoria"
         id="produtos">

    <div class="categoria-header">

        <div>

            <span class="categoria-label">
                HARDWARE
            </span>

            <h2>
                MONTE SEU PC
            </h2>

            <p>
                Componentes para levar sua máquina ao próximo nível.
            </p>

        </div>

        <a href="#"
           class="categoria-link">

            Ver todos
            <i class="bi bi-arrow-right"></i>

        </a>

    </div>


    <div class="produtos">


        <!-- CPU AMD -->

        <div class="produto-card">

            <div class="produto-image">

                <span class="produto-badge">
                    DESTAQUE
                </span>

                <img src="~/images/produtos/cpu-amd.png"
                     alt="Processador Ryzen AMD">

            </div>

            <div class="produto-info">

                <span class="produto-categoria">
                    PROCESSADOR
                </span>

                <h3>
                    Ryzen AMD
                </h3>

                <div class="produto-bottom">

                    <span class="produto-preco">
                        R$ 1.999
                    </span>

                    <button class="produto-button">
                        <i class="bi bi-cart-plus"></i>
                    </button>

                </div>

            </div>

        </div>


        <!-- GPU -->

        <div class="produto-card">

            <div class="produto-image">

                <span class="produto-badge">
                    DESTAQUE
                </span>

                <img src="~/images/produtos/gpu.png"
                     alt="Placa de vídeo RTX">

            </div>

            <div class="produto-info">

                <span class="produto-categoria">
                    PLACA DE VÍDEO
                </span>

                <h3>
                    RTX 4070
                </h3>

                <div class="produto-bottom">

                    <span class="produto-preco">
                        R$ 3.999
                    </span>

                    <button class="produto-button">
                        <i class="bi bi-cart-plus"></i>
                    </button>

                </div>

            </div>

        </div>


        <!-- SSD -->

        <div class="produto-card">

            <div class="produto-image">

                <img src="~/images/produtos/ssd.png"
                     alt="SSD">

            </div>

            <div class="produto-info">

                <span class="produto-categoria">
                    ARMAZENAMENTO
                </span>

                <h3>
                    SSD
                </h3>

                <div class="produto-bottom">

                    <span class="produto-preco">
                        R$ 499
                    </span>

                    <button class="produto-button">
                        <i class="bi bi-cart-plus"></i>
                    </button>

                </div>

            </div>

        </div>


        <!-- INTEL -->

        <div class="produto-card">

            <div class="produto-image">

                <img src="~/images/produtos/cpu-intel.png"
                     alt="Processador Intel">

            </div>

            <div class="produto-info">

                <span class="produto-categoria">
                    PROCESSADOR
                </span>

                <h3>
                    Intel
                </h3>

                <div class="produto-bottom">

                    <span class="produto-preco">
                        R$ 1.799
                    </span>

                    <button class="produto-button">
                        <i class="bi bi-cart-plus"></i>
                    </button>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =====================================================
     PERIFÉRICOS
     ===================================================== -->

