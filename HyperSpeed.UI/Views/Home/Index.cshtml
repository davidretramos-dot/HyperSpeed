@{
    ViewData["Title"] = "Home";
}
<link rel="stylesheet" href="/css/style.css">
<header>

    <div class="top-bar">

        <div class="logo">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="Logo">
                </a>
            </div>

            <div class="search">
                <form asp-controller="Produto" asp-action="Pesquisar" method="get">

                    <input type="text"
                           name="pesquisa"
                           placeholder="Pesquisar produtos..." />

                </form>
            </div>

            <div class="account">

                <a asp-controller="Conta" asp-action="Login">
                    Conta
                </a>

                |

                <a asp-controller="Favorito" asp-action="Index">
                    Favoritos
                </a>


            </div>

        </div>


        <a href="#">Carrinho</a>
        <a href="#">Monte seu PC</a>
        <a href="#">Departamentos</a>
        <a href="#">Periféricos</a>
        <a href="#">Promoções</a>

    </header>



    <section class="banner">


        <img src="~/images/banner.jpg" alt="Banner">

        <img src="~/images/banner.jpg" alt="Banner Principal">


        </section>

        <section class="slogan">

            <p>Tudo do bom e mais barato</p>

            <h1>CONFIRA!</h1>

        </section>

        <section class="categoria">

            <h2>MONTE SEU PC</h2>

            <div class="produtos">

                <div class="produto-card">

                    <img src="~/images/produtos/cpu-amd.png">

                    <img src="~/images/produtos/cpu-amd.png" alt="Ryzen AMD">

                        <span>R$ 1.999</span>
                    </div>

                    <div class="produto-card">

                        <img src="~/images/produtos/gpu.png">

                        <img src="~/images/produtos/gpu.png" alt="RTX">

                            <span>R$ 3.999</span>
                        </div>

                        <div class="produto-card">

                            <img src="~/images/produtos/ssd.png">

                            <img src="~/images/produtos/ssd.png" alt="SSD">

                                <span>R$ 499</span>
                            </div>

                            <div class="produto-card">

                                <img src="~/images/produtos/cpu-intel.png">

                                <img src="~/images/produtos/cpu-intel.png" alt="Intel">

                                    <span>R$ 1.799</span>
                                </div>

                            </div>

                        </section>

                        <section class="categoria">

                            <h2>PERIFÉRICOS / OUTROS</h2>

                            <div class="produtos">

                                <div class="produto-card">

                                    <img src="~/images/produtos/teclado.png">

                                    <img src="~/images/produtos/teclado.png" alt="Teclado">

                                        <span>R$ 399</span>
                                    </div>

                                    <div class="produto-card">

                                        <img src="~/images/produtos/headset.png">

                                        <img src="~/images/produtos/headset.png" alt="Headset">

                                            <span>R$ 299</span>
                                        </div>

                                        <div class="produto-card">

                                            <img src="~/images/produtos/mouse.png">

                                            <img src="~/images/produtos/mouse.png" alt="Mouse">

                                                <span>R$ 199</span>
                                            </div>

                                            <div class="produto-card">

                                                <img src="~/images/produtos/monitor.png">

                                                <img src="~/images/produtos/monitor.png" alt="Monitor">

                                                    <span>R$ 1.299</span>
                                                </div>

                                            </div>

                                        </section>