            </span>

            <h2>
                PERIFÉRICOS / OUTROS
            </h2>

            <p>
                Tudo para completar seu setup gamer.
            </p>

        </div>

        <a href="#"
           class="categoria-link">

            Ver todos
            <i class="bi bi-arrow-right"></i>

        </a>

    </div>


    <div class="produtos">


        <!-- TECLADO -->

        <div class="produto-card">

            <div class="produto-image">

                <img src="~/images/produtos/teclado.png"
