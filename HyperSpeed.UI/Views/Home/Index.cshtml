@using hyperSpeed.Application.ViewModels

@model HomeViewModels

@{

    ViewData["Title"] = "Home";

}

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

<link rel="icon"
      type="image/png"
      href="~/img/Icone HS.png">

 
<!-- =====================================================

     BANNER

===================================================== -->

<section class="banner">

    <div class="banner-overlay"></div>

    @*
<img src="~/img/BannerIndexRemake.png"

         alt="HyperSpeed - Ofertas em hardware"

         class="banner-img">

    *@
 
    <div class="banner-content">

        <span class="banner-tag">

            HYPERSPEED
        </span>

        <h1>

            MONTE O PC<br>
            <strong>DOS SEUS SONHOS.</strong>
        </h1>

        <p>

            Hardware de alta performance pelo melhor preço.
        </p>

        <a asp-controller="Produto"
           asp-action="Index"
           class="banner-button">

            <i class="bi bi-cart-fill"></i>

            Conferir produtos

        </a>

    </div>

</section>

 
<!-- =====================================================

     SLOGAN

===================================================== -->

<section class="slogan">

    <div class="slogan-line"></div>

    <p>

        Tudo do bom e mais barato
    </p>

    <h1>

        CONFIRA!
    </h1>

    <span>

        Encontre os melhores componentes para seu setup.
    </span>

    <div class="slogan-line"></div>

</section>

 
<!-- =====================================================

     MONTE SEU PC

===================================================== -->

<section class="categoria"
         id="produtos">

    <div class="categoria-header">

        <div>

            <span class="categoria-label">

                HARDWARE
            </span>

            <h2>

                MONTE SEU PC
            </h2>

            <p>

                Componentes para levar sua máquina ao próximo nível.
            </p>

        </div>

 
        <a asp-controller="Produto"
           asp-action="Index"
           class="categoria-link">

            Ver todos

            <i class="bi bi-arrow-right"></i>

        </a>

    </div>

 
    <div class="produtos">

        @if (Model?.ProdutosDestaque != null &&

                     Model.ProdutosDestaque.Any())

        {

            @foreach (var produto in Model.ProdutosDestaque)

            {
                <div class="produto-card">

                    <a asp-controller="Produto"
                       asp-action="Details"
                       asp-route-id="@produto.Id"
                       class="produto-card-link">

                        <div class="produto-image">

                            @if (produto.Destaque)

                            {
                                <span class="produto-badge">

                                    DESTAQUE
                                </span>

                            }

                            @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))

                            {
                                <img src="@produto.ImagemUrl"
                                     alt="@produto.NomeProduto"
                                     onerror="this.style.display='none'" />

                            }

                        </div>

 
                        <div class="produto-info">

                            <span class="produto-categoria">

                                PRODUTO
                            </span>

 
                            <h3>

                                @produto.NomeProduto
                            </h3>

                        </div>

                    </a>

 
                    <div class="produto-bottom">

                        <span class="produto-preco">

                            R$ @produto.Preco.ToString("N2")

                        </span>

 
                        <form asp-controller="Carrinho"
                              asp-action="Adicionar"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="produtoId" value="@produto.Id" />
                            <input type="hidden" name="nome" value="@produto.NomeProduto" />
                            <input type="hidden" name="preco" value="@produto.Preco" />

                            <button type="submit" class="produto-button" title="Adicionar ao carrinho">

                                <i class="bi bi-cart-plus"></i>

                            </button>

                        </form>

                    </div>

                </div>

            }

        }

        else

        {
            <p class="sem-produtos">

                Nenhum produto disponível no momento.
            </p>

        }

    </div>

</section>

 
<!-- =====================================================

     PERIFÉRICOS

===================================================== -->

<section class="categoria categoria-perifericos">

    <div class="categoria-header">

        <div>

            <span class="categoria-label">

                NOVIDADES
            </span>

            <h2>

                PRODUTOS RECENTES
            </h2>

            <p>

                Os últimos lançamentos que chegaram na loja.
            </p>

        </div>

 
        <a asp-controller="Produto"
           asp-action="Index"
           class="categoria-link">

            Ver todos

            <i class="bi bi-arrow-right"></i>

        </a>

    </div>

 
    <div class="produtos">

        @if (Model?.ProdutosRecentes != null &&

                     Model.ProdutosRecentes.Any())

        {

            @foreach (var produto in Model.ProdutosRecentes)

            {
                <div class="produto-card">

                    <a asp-controller="Produto"
                       asp-action="Details"
                       asp-route-id="@produto.Id"
                       class="produto-card-link">

                        <div class="produto-image">

                            @if (produto.Destaque)

                            {
                                <span class="produto-badge">

                                    DESTAQUE
                                </span>

                            }

                            @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))

                            {
                                <img src="@produto.ImagemUrl"
                                     alt="@produto.NomeProduto"
                                     onerror="this.style.display='none'" />

                            }

                        </div>

 
                        <div class="produto-info">

                            <span class="produto-categoria">

                                @(string.IsNullOrWhiteSpace(produto.NomeCategoria)
                                    ? "PRODUTO"
                                    : produto.NomeCategoria.ToUpper())
                            </span>

 
                            <h3>

                                @produto.NomeProduto
                            </h3>

                        </div>

                    </a>

 
                    <div class="produto-bottom">

                        <span class="produto-preco">

                            R$ @produto.Preco.ToString("N2")

                        </span>

 
                        <form asp-controller="Carrinho"
                              asp-action="Adicionar"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="produtoId" value="@produto.Id" />
                            <input type="hidden" name="nome" value="@produto.NomeProduto" />
                            <input type="hidden" name="preco" value="@produto.Preco" />

                            <button type="submit" class="produto-button" title="Adicionar ao carrinho">

                                <i class="bi bi-cart-plus"></i>

                            </button>

                        </form>

                    </div>

                </div>

            }

        }

        else

        {
            <p class="sem-produtos">

                Nenhum produto disponível no momento.
            </p>

        }

    </div>

</section>

 