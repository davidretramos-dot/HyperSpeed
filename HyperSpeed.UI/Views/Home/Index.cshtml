            </div>

            <div class="produto-info">

                <span class="produto-categoria">
                    ÁUDIO
                </span>

                <h3>
                    Headset
                </h3>

                <div class="produto-bottom">

                    <span class="produto-preco">
                        R$ 299
                    </span>

                    <button class="produto-button">
                        <i class="bi bi-cart-plus"></i>
                    </button>

                </div>

            </div>

        </div>


        <!-- MOUSE -->

        <div class="produto-card">

            <div class="produto-image">

                <img src="~/images/produtos/mouse.png"
                     alt="Mouse">

            </div>

            <div class="produto-info">

                <span class="produto-categoria">
                    PERIFÉRICO
                </span>

                <h3>
                    Mouse
                </h3>

                <div class="produto-bottom">

                    <span class="produto-preco">
                        R$ 199
                    </span>

                    <button class="produto-button">
                        <i class="bi bi-cart-plus"></i>
                    </button>

                </div>

            </div>

        </div>


        <!-- MONITOR -->

        <div class="produto-card">

            <div class="produto-image">

                <span class="produto-badge">
                    OFERTA
                </span>

                <img src="~/images/produtos/monitor.png"
                     alt="Monitor">

            </div>

            <div class="produto-info">

                <span class="produto-categoria">
                    MONITOR
                </span>

                <h3>
                    Monitor Gamer
                </h3>

                <div class="produto-bottom">

                    <span class="produto-preco">
                        R$ 1.299
                    </span>

                    <button class="produto-button">
                        <i class="bi bi-cart-plus"></i>
                    </button>

                </div>

            </div>

        </div>

    </div>

</section>