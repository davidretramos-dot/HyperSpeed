@{
    ViewData["Title"] = "Sobre a empresa";
}

<section class="sobre-page">

    <div class="sobre-header">

        <span class="sobre-label">
            HYPERSPEED STORE
        </span>

        <h1>
            SOBRE A <strong>EMPRESA</strong>
        </h1>

        <p>
            Conheça um pouco mais sobre a HyperSpeed e o nosso propósito.
        </p>

    </div>


    <div class="sobre-content">

        <div class="sobre-card sobre-card-destaque">

            <div class="sobre-icon">
                <i class="bi bi-speedometer2"></i>
            </div>

            <div>
                <h2>
                    QUEM SOMOS
                </h2>

                <p>
                    A HyperSpeed é uma loja especializada em hardware e
                    componentes para computadores. Nosso objetivo é oferecer
                    produtos de qualidade para quem busca montar, melhorar
                    ou atualizar seu setup.
                </p>

                <p>
                    Trabalhamos para proporcionar uma experiência de compra
                    simples, rápida e segura para nossos clientes.
                </p>
            </div>

        </div>


        <div class="sobre-grid">

            <div class="sobre-card">

                <div class="sobre-icon">
                    <i class="bi bi-bullseye"></i>
                </div>

                <h2>
                    NOSSO OBJETIVO
                </h2>

                <p>
                    Tornar o acesso a componentes de informática mais simples,
                    oferecendo variedade, praticidade e preços competitivos.
                </p>

            </div>


            <div class="sobre-card">

                <div class="sobre-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <h2>
                    CONFIANÇA
                </h2>

                <p>
                    Buscamos construir uma relação de confiança com nossos
                    clientes, oferecendo informações claras e uma experiência
                    de compra segura.
                </p>

            </div>


            <div class="sobre-card">

                <div class="sobre-icon">
                    <i class="bi bi-pc-display"></i>
                </div>

                <h2>
                    HARDWARE
                </h2>

                <p>
                    Componentes para diferentes tipos de usuários, desde
                    upgrades e manutenção até setups de alto desempenho.
                </p>

            </div>

        </div>


        <div class="sobre-final">

            <span>
                HYPERSPEED
            </span>

            <h2>
                SEU SETUP COMEÇA AQUI.
            </h2>

            <a asp-controller="Produto"
               asp-action="Index"
               class="sobre-button">

                CONFERIR PRODUTOS

                <i class="bi bi-arrow-right"></i>

            </a>

        </div>

    </div>

</section>