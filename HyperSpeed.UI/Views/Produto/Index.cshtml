@using hyperSpeed.Application.ViewModels

@model ProdutoListViewModel

@{
    ViewData["Title"] = "Produtos";
}

<section class="produtos-page">

    <div class="produtos-page-header">

        <div>
            <span class="produtos-page-label">
                HYPERSPEED / PRODUTOS
            </span>

            <h1>
                @(string.IsNullOrWhiteSpace(Model.CategoriaNome)
                    ? "Todos os Produtos"
                    : Model.CategoriaNome)
            </h1>

            <p>
                Explore nosso catálogo completo de hardware e periféricos.
            </p>
        </div>

        <div class="produtos-page-icon">
            <i class="bi bi-grid-fill"></i>
        </div>

    </div>

    <div class="produtos-filtros">

        <form asp-controller="Produto"
              asp-action="Index"
              method="get"
              class="produtos-busca">

            <i class="bi bi-search"></i>

            <input type="text"
                   name="pesquisa"
                   value="@Model.Pesquisa"
                   placeholder="Pesquisar produto..." />

            <button type="submit">
                Buscar
            </button>

        </form>

        @if (Model.Categorias != null && Model.Categorias.Any())
        {
            <div class="produtos-categorias">

                <a asp-controller="Produto"
                   asp-action="Index"
                   class="categoria-chip @(Model.CategoriaId == null ? "ativa" : "")">
                    Todas
                </a>

                @foreach (var categoria in Model.Categorias)
                {
                    <a asp-controller="Produto"
                       asp-action="Index"
                       asp-route-idCategoria="@categoria.Id"
                       class="categoria-chip @(Model.CategoriaId == categoria.Id ? "ativa" : "")">
                        @categoria.Nome
                    </a>
                }

            </div>
        }

    </div>

    <div class="produtos">

        @if (Model.Produtos != null && Model.Produtos.Any())
        {
            @foreach (var produto in Model.Produtos)
            {
                <div class="produto-card">

                    <a asp-controller="Produto"
                       asp-action="Details"
                       asp-route-id="@produto.Id"
                       class="produto-card-link">

                        <div class="produto-image">

                            @if (produto.Destaque)
                            {
                                <span class="produto-badge">
                                    DESTAQUE
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(produto.Imagem))
                            {
                                <img src="@produto.Imagem"
                                     alt="@produto.Nome"
                                     onerror="this.style.display='none'" />
                            }

                        </div>

                        <div class="produto-info">

                            <span class="produto-categoria">
                                @(produto.Categoria?.Nome ?? "PRODUTO")
                            </span>

                            <h3>
                                @produto.Nome
                            </h3>

                        </div>

                    </a>

                    <div class="produto-bottom">

                        <span class="produto-preco">
                            R$ @produto.Preco.ToString("N2")
                        </span>

                        <form asp-controller="Carrinho"
                              asp-action="Adicionar"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden" name="produtoId" value="@produto.Id" />
                            <input type="hidden" name="nome" value="@produto.Nome" />
                            <input type="hidden" name="preco" value="@produto.Preco" />

                            <button type="submit" class="produto-button" title="Adicionar ao carrinho">
                                <i class="bi bi-cart-plus"></i>
                            </button>

                        </form>

                    </div>

                </div>
            }
        }
        else
        {
            <p class="sem-produtos">
                Nenhum produto encontrado.
            </p>
        }

    </div>

</section>
