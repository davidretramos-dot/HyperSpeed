@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HyperSpeed Admin</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/img/Icone HS.png" />

         
</head>

<body class="admin-body">

    <div class="admin-layout">

        <!-- SIDEBAR -->
        <aside class="admin-sidebar">

            <div class="admin-brand">

                <div class="admin-brand-icon">
                    <i class="bi bi-speedometer2"></i>
                </div>

                <div>
                    <strong>HYPER</strong>
                    <strong>SPEED</strong>
                </div>

            </div>


            <div class="admin-divider"></div>


            <div class="admin-menu-title">
                ADMINISTRAÇÃO
            </div>


            <nav class="admin-menu">

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-menu-item @(controller == "Admin" && action == "Index" ? "active" : "")">

                    <i class="bi bi-grid-fill"></i>
                    <span>Dashboard</span>

                </a>
                <a asp-controller="Admin"
                   asp-action="Produtos"
                   class="admin-menu-item @(controller == "Admin" && action == "Produtos" ? "active" : "")">

                    <i class="bi bi-box-seam"></i>
                    <span>Produtos</span>

                </a>

                <a asp-controller="Admin"
                   asp-action="Categorias"
                   class="admin-menu-item @(controller == "Admin" && action == "Categorias" ? "active" : "")">
                    <i class="bi bi-tags"></i>

                    <span>Categorias</span>

                </a>



                <a asp-controller="Pedido"
                   asp-action="Index"
                   class="@(controller == "Pedido" ? "active" : "")">

                    <i class="bi bi-cart-fill"></i>
                    <span>Pedidos</span>

                </a>

            </nav>


            <div class="admin-sidebar-bottom">

                <a asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-arrow-left-circle-fill"></i>

                    <span>Voltar ao Site</span>

                </a>

            </div>

        </aside>


        <!-- CONTEÚDO -->
        <main class="admin-main">

            @RenderBody()

        </main>

    </div>


    @RenderSection("Scripts", required: false)

</body>

</html>