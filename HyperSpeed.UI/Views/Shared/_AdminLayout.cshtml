@{
    Layout = "_Layout";
}

<div class="admin-layout d-flex">

    <aside class="admin-sidebar p-3" style="min-width:220px;">
        <h4 class="mb-3">ADMIN</h4>

        <nav class="nav flex-column">
            <a asp-controller="Admin" asp-action="Index" class="nav-link">Dashboard</a>
            <a asp-controller="Admin" asp-action="Produtos" class="nav-link">Produtos</a>
            <a asp-controller="Admin" asp-action="Categorias" class="nav-link">Categorias</a>
            <a asp-controller="Pedido" asp-action="Index" class="nav-link">Pedidos</a>
            <a asp-controller="Home" asp-action="Index" class="nav-link">Voltar ao Site</a>
        </nav>
    </aside>

    <main class="admin-main flex-fill p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h4">@ViewData["Title"]</h1>
                @if (ViewData["Subtitle"] != null)
                {
                    <small class="text-muted">@ViewData["Subtitle"]</small>
                }
            </div>

            <div class="admin-actions">
                <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary me-2">
                    <i class="bi bi-speedometer2"></i> Ir para Dashboard
                </a>
                <a asp-controller="Admin" asp-action="CreateProd" class="btn btn-primary me-2">Novo Produto</a>
                <a asp-controller="Admin" asp-action="CreateCategoria" class="btn btn-outline-primary">Nova Categoria</a>
            </div>
        </div>

        @RenderBody()
    </main>
</div>

@RenderSection("Scripts", required: false)

