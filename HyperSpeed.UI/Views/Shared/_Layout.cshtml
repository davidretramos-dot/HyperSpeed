@* Views/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Hyper Speed</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @* Ícone que aparece na aba do navegador *@
    <link rel="icon"
          type="image/png"
          href="~/img/Icone HS.png" />

    @* Bootstrap Icons, caso as páginas utilizem bi bi-* *@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @RenderSection("Styles", required: false)

</head>

<body>

    <header class="site-header">

        <div class="top-bar">

            @* Logo da Hyper Speed *@
            <div class="logo">

                <a asp-controller="Home"
                   asp-action="Index">

                    <img src="~/img/Logo HS.png"
                         alt="Hyper Speed" />

                </a>

            </div>


            @* Barra de pesquisa *@
            <form class="search"
                  asp-controller="Produto"
                  asp-action="Index"
                  method="get">

                <input type="text"
                       name="pesquisa"
                       placeholder="Pesquisar..." />

                <button type="submit"
                        aria-label="Pesquisar">
                    <i class="bi bi-search"></i>
                </button>

            </form>


            @* Área da conta *@
            <div class="account">

                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Conta"
                       asp-action="Perfil">

                        <i class="bi bi-person-circle"></i>

                        Conta

                    </a>
                }
                else
                {
                    <a asp-controller="Conta"
                       asp-action="Login">

                        <i class="bi bi-person-circle"></i>

                        Conta

                    </a>
                }


                <a asp-controller="Favorito"
                   asp-action="Index">

                    <span class="favorite-icon">★</span>

                    Favoritos

                </a>

            </div>

        </div>


        @* Menu principal *@
        <nav class="main-nav">

            <!-- MENU SUSPENSO -->
            <div class="menu-dropdown">

                <button type="button"
                        class="menu-icon"
                        id="menuDropdownButton"
                        aria-label="Abrir menu"
                        aria-expanded="false">

                    <i class="bi bi-list"></i>

                </button>


                <div class="menu-dropdown-content" id="menuDropdownContent">

                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="dropdown-item">

                            <i class="bi bi-speedometer2"></i>

                            <span>Admin</span>

                        </a>
                    }


                    <a asp-controller="Carrinho"
                       asp-action="Index"
                       class="dropdown-item">

                        <i class="bi bi-cart3"></i>

                        <span>Carrinho</span>

                    </a>


                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Pedido"
                           asp-action="Index"
                           class="dropdown-item">

                            <i class="bi bi-bag-check"></i>

                            <span>Meus Pedidos</span>

                        </a>
                    }

                </div>

            </div>


            <!-- RESTANTE DO MENU -->

            <a asp-controller="Produto"
               asp-action="Index"
               asp-fragment="produtos">

                Monte seu PC

            </a>


            <a asp-controller="Categoria"
               asp-action="Index">

                Departamentos

            </a>


            <a asp-controller="Produto"
               asp-action="Perifericos">

                Periféricos

            </a>


            <a asp-controller="Produto"
               asp-action="Promocoes"
               class="promotion">

                Promoções

            </a>


            @if (User?.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Conta"
                      asp-action="Logout"
                      method="post"
                      class="logout-form">

                    <button type="submit">

                        <i class="bi bi-box-arrow-right"></i>

                        Sair

                    </button>

                </form>
            }

        </nav>

    </header>

 
    @* Conteúdo de cada página *@
    <main>

        @RenderBody()

    </main>

 
    <footer>

        <div class="footer-container">

            <div class="footer-box">

                <h2>AJUDA</h2>

                <a href="#">
                    Fale conosco
                </a>

                <a href="#">
                    Políticas e Privacidade
                </a>

                <a href="#">
                    Termos de Aceite
                </a>

            </div>

 
            <div class="footer-box">

                <h2>DÚVIDAS</h2>

                <a href="#">
                    Entrega
                </a>

                <a href="#">
                    Garantia
                </a>

                <a href="#">
                    Como pagar
                </a>

            </div>

 
            <div class="footer-box">

                <h2>PAGAMENTO</h2>

                <p>PIX</p>
                <p>VISA</p>
                <p>MASTERCARD</p>
                <p>BOLETO</p>

            </div>

        </div>

 
        <div class="copyright">

            © Desenvolvido Por Caramelo Tech - TI31

        </div>

    </footer>

 
    @RenderSection("Scripts", required: false)

 
    <script src="~/js/site.js" asp-append-version="true"></script>

  

</body>

</html>