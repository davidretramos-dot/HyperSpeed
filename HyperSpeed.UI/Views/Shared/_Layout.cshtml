
@* Views\Shared\_Layout.cshtml *@
<!DOCTYPE html>
<html lang="pt-br">


<head>
    <title>Hyper Speed</title>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Hyper Speed</title>

    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="icon"
          type="image/png"
          href="img/Icone HS.png">

</head>

<body>


    <header class="site-header">

    <partial name="_Header" />


    <partial name="_Navbar" />

            <div class="logo">
                <img src="img/Logo HS.png" alt="Hyper Speed">
            </div>

            <div class="search">
                <input type="text" placeholder="Pesquisa">
            </div>

            <div class="account">

                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Conta" asp-action="AccessDenied">
                        Conta
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="admin-link">
                            Admin
                        </a>
                    }

                    <form asp-controller="Conta"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">

                        @Html.AntiForgeryToken()

                        <button type="submit">
                            Sair
                        </button>

                    </form>
                }
                else
                {
                    <a asp-controller="Conta" asp-action="Login">
                        Conta
                    </a>
                }

                <span class="favorite-icon">★</span>

                <a asp-controller="Favorito" asp-action="Index">
                    Favoritos
                </a>
                </div>
                </header>
    <main>

        @RenderBody()

    </main>




    <main>
        @RenderBody()
    </main>


    <footer>

        <div class="footer-container">

            <div class="footer-box">
                <h2>AJUDA</h2>

                <a href="#">Fale conosco</a>
                <a href="#">Políticas e Privacidade</a>
                <a href="#">Termos de Aceite</a>
            </div>

            <div class="footer-box">
                <h2>DÚVIDAS</h2>

                <a href="#">Entrega</a>
                <a href="#">Garantia</a>
                <a href="#">Como pagar</a>
            </div>

            <div class="footer-box">
                <h2>PAGAMENTO</h2>

                <p>PIX</p>
                <p>VISA</p>
                <p>MASTERCARD</p>
                <p>BOLETO</p>
            </div>

        </div>

        <div class="copyright">
            © Desenvolvido Por Caramelo Tech - TI31
        </div>

    </footer>


    @RenderSection("Scripts", required: false)

</body>
    <script src="~/js/menu.js"></script>
    <script src="~/js/carousel.js"></script>

</html>